---
/**
 * Home services section (eyebrow "Usluge", h2 "Sve na jednom mjestu";
 * user reference: "Construction Services").
 * Left: h2, lead and a card listing all 6 services (PRD §2.2) as vertical
 * tabs. Right: the active service's panel (two images, title, text and a
 * "Saznaj više" link to its anchor on /usluge).
 *
 * Behaviour: accessible tabs (WAI-ARIA tabs pattern, automatic activation).
 * Click, or ↑/↓/Home/End on the focused list, switches the panel. All panels
 * share one grid cell, so the column is as tall as the tallest panel (no
 * layout jump) and switching is a true crossfade. Without JS the first
 * service stays visible.
 *
 * Images are PLACEHOLDERS: the hero van photo, cropped to the loading docks
 * and to the van (user decision). Replace `images` per service with the
 * client's photos.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon, { type IconName } from '../icons/Icon.astro';
import TextLink from '../TextLink.astro';
import { services, type ServiceSlug } from '../../data/site';
import vanPhoto from '../../assets/hero-van.png';

interface PanelImage {
	src: ImageMetadata;
	alt: string;
	/** CSS object-position for the 4:5 crop. */
	position: string;
}

// Placeholder pair shared by every service until real photos arrive.
const placeholderImages: PanelImage[] = [
	{ src: vanPhoto, alt: 'Utovarne rampe skladišta', position: '8% center' },
	{ src: vanPhoto, alt: 'Bijeli dostavni kombi ispred skladišta', position: '88% center' },
];

// Placeholder copy (needs client approval).
const details: Record<ServiceSlug, { icon: IconName; text: string; images: PanelImage[] }> = {
	'prijevoz-i-dostava': {
		icon: 'truck',
		text: 'Prevozimo i dostavljamo pošiljke svih veličina – od jednog paketa do punog kombija robe. Dogovorimo termin koji vam odgovara i robu sigurno dovezemo na adresu, bilo gdje u Hrvatskoj.',
		images: placeholderImages,
	},
	selidbe: {
		icon: 'sofa',
		text: 'Selimo stanove, kuće i urede od pakiranja do posljednje kutije. Namještaj pažljivo rastavljamo, štitimo i ponovno slažemo, a vi se brinete samo o tome gdje će što stajati.',
		images: placeholderImages,
	},
	skladistenje: {
		icon: 'warehouse',
		text: 'Trebate privremeno spremiti namještaj, robu ili opremu? Vaše stvari čuvamo u sigurnom i suhom prostoru – na kraće ili dulje vrijeme – i dostavljamo ih kad vam zatrebaju.',
		images: placeholderImages,
	},
	'uredenje-okolisa': {
		icon: 'trees',
		text: 'Uređujemo dvorišta, vrtove i okućnice: košnja, orezivanje, čišćenje zelenih površina i odvoz otpada. Vaš okoliš ostaje uredan bez vašeg truda.',
		images: placeholderImages,
	},
	'ciscenje-prostora': {
		icon: 'sparkles',
		text: 'Čistimo stanove, kuće, urede i poslovne prostore – nakon selidbe, renovacije ili redovito. Prostor vam predajemo čist i spreman za korištenje.',
		images: placeholderImages,
	},
	'dodatne-usluge': {
		icon: 'circle-plus',
		text: 'Odvoz glomaznog otpada, pražnjenje podruma i tavana, montaža namještaja i druge sitne usluge. Recite nam što vam treba, a mi ćemo pronaći rješenje.',
		images: placeholderImages,
	},
};

const items = services.map((service, index) => ({
	...service,
	...details[service.slug],
	tabId: `usluga-tab-${service.slug}`,
	panelId: `usluga-panel-${service.slug}`,
	active: index === 0,
}));
---

<section class="services" aria-labelledby="services-title">
	<div class="container services__inner" data-reveal>
		<div class="services__intro">
			<p class="eyebrow eyebrow--accent" id="services-eyebrow">Usluge</p>
			<h2 id="services-title" class="services__title">Sve na jednom mjestu</h2>
			<p class="services__lead">
				Od jedne pošiljke do kompletne selidbe – jedan tim za sve što vam treba.
			</p>

			<!-- Labelled by the eyebrow, so the list is announced as "Usluge". -->
			<div
				class="services__tabs"
				role="tablist"
				aria-orientation="vertical"
				aria-labelledby="services-eyebrow"
				data-services-tabs
			>
				{
					items.map((item) => (
						<button
							type="button"
							role="tab"
							id={item.tabId}
							class="services__tab"
							aria-selected={item.active ? 'true' : 'false'}
							aria-controls={item.panelId}
							tabindex={item.active ? 0 : -1}
						>
							<Icon name={item.icon} size={22} strokeWidth={1.5} class="services__tab-icon" />
							<span class="services__tab-label">{item.name}</span>
							<Icon name="arrow-up-right" size={20} strokeWidth={1.5} class="services__tab-arrow" />
						</button>
					))
				}
			</div>
		</div>

		<div class="services__panels">
			{
				items.map((item) => (
					<div
						role="tabpanel"
						id={item.panelId}
						class:list={['services__panel', { 'is-active': item.active }]}
						aria-labelledby={item.tabId}
						tabindex="0"
					>
						<div class="services__images">
							{item.images.map((image) => (
								<Image
									src={image.src}
									alt={image.alt}
									widths={[960, 1280, image.src.width]}
									sizes="(min-width: 1188px) 680px, 60vw"
									format="webp"
									class="services__image"
									style={`--image-position: ${image.position}`}
								/>
							))}
						</div>
						<p class="services__panel-title">{item.name}</p>
						<p class="services__panel-text">{item.text}</p>
						<TextLink href={`/usluge#${item.slug}`} class="services__link">
							Saznaj više<span class="visually-hidden"> o usluzi {item.name}</span>
						</TextLink>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	// Vertical tabs (WAI-ARIA tabs pattern, automatic activation).
	document.querySelectorAll<HTMLElement>('[data-services-tabs]').forEach((tablist) => {
		const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

		const select = (next: HTMLButtonElement, focus = false) => {
			for (const tab of tabs) {
				const selected = tab === next;
				tab.setAttribute('aria-selected', String(selected));
				tab.tabIndex = selected ? 0 : -1;
				const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
				panel?.classList.toggle('is-active', selected);
			}
			if (focus) next.focus();
		};

		tablist.addEventListener('click', (event) => {
			const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
			if (tab) select(tab);
		});

		tablist.addEventListener('keydown', (event) => {
			const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
			if (current === -1) return;

			const last = tabs.length - 1;
			const target: Record<string, number> = {
				ArrowDown: current === last ? 0 : current + 1,
				ArrowUp: current === 0 ? last : current - 1,
				Home: 0,
				End: last,
			};
			if (!(event.key in target)) return;

			event.preventDefault();
			select(tabs[target[event.key]], true);
		});
	});
</script>

<style>
	.services {
		padding-block: var(--section-padding-y);
		background-color: var(--color-primary-shade);
		color: var(--color-dark);
	}

	.services__inner {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		align-items: start;
		gap: var(--space-16);
	}

	/* eyebrow → 16px → h2, as in the About section */
	.services__title {
		margin-top: var(--space-4);
	}

	.services__lead {
		max-width: 360px;
		margin-top: var(--space-4);
		color: var(--color-dark-80);
	}

	/* ---- Service list (card) ---- */
	.services__tabs {
		display: grid;
		margin-top: var(--space-10);
		padding: var(--space-2) var(--space-6);
		border-radius: var(--radius);
		background-color: var(--color-primary);
	}

	.services__tab {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-4);
		width: 100%;
		padding-block: var(--space-5);
		border: 0;
		background: none;
		color: var(--color-dark);
		font-weight: var(--weight-medium);
		text-align: left;
		cursor: pointer;
		transition: color var(--duration-fast) ease;
	}

	.services__tab + .services__tab {
		border-top: 1px solid var(--color-border);
	}

	.services__tab:hover,
	.services__tab[aria-selected='true'] {
		color: var(--color-accent);
	}

	.services__tab:focus-visible {
		outline-offset: 0;
	}

	.services__tab :global(.services__tab-arrow) {
		transition: transform var(--duration-fast) ease;
	}

	.services__tab:hover :global(.services__tab-arrow),
	.services__tab[aria-selected='true'] :global(.services__tab-arrow) {
		transform: translate(2px, -2px);
	}

	/* ---- Panels: stacked in one cell, the active one fades in ---- */
	.services__panels {
		display: grid;
	}

	.services__panel {
		grid-area: 1 / 1;
		visibility: hidden;
		opacity: 0;
		transition:
			opacity var(--duration-panel) ease,
			visibility 0s linear var(--duration-panel);
	}

	.services__panel.is-active {
		visibility: visible;
		opacity: 1;
		transition:
			opacity var(--duration-panel) ease,
			visibility 0s;
	}

	.services__panel:focus-visible {
		outline-offset: var(--space-2);
	}

	.services__images {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	.services__panel :global(.services__image) {
		width: 100%;
		aspect-ratio: 4 / 5;
		height: auto;
		object-fit: cover;
		object-position: var(--image-position, center);
		border-radius: var(--radius);
	}

	.services__panel-title {
		margin-top: var(--space-6);
		font-size: var(--text-lg);
		line-height: var(--leading-lg);
		font-weight: var(--weight-semibold);
	}

	.services__panel-text {
		max-width: 560px;
		margin-top: var(--space-2);
		color: var(--color-dark-80);
	}

	.services__panel :global(.services__link) {
		margin-top: var(--space-4);
	}

	@media (prefers-reduced-motion: reduce) {
		.services__tab,
		.services__tab :global(.services__tab-arrow),
		.services__panel,
		.services__panel.is-active {
			transition: none;
		}
	}
</style>
