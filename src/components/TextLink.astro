---
/**
 * Inline text link with a trailing arrow, for light sections
 * (e.g. "Više o nama →"). Accent colour, underlined label; on hover the
 * colour darkens and the arrow nudges right, like the primary Button.
 */
import Icon from './icons/Icon.astro';

interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={['text-link', className]}>
	<span class="text-link__label"><slot /></span>
	<Icon name="arrow-right" size={16} strokeWidth={1.5} class="text-link__icon" />
</a>

<style>
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: var(--button-gap);
		font-size: var(--text-body);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-body);
		color: var(--color-accent);
		transition: color var(--duration-fast) ease;
	}

	.text-link__label {
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.text-link:hover {
		color: var(--color-accent-hover);
	}

	.text-link :global(.text-link__icon) {
		transition: transform var(--duration-fast) ease;
	}

	.text-link:hover :global(.text-link__icon) {
		transform: translateX(3px);
	}

	@media (prefers-reduced-motion: reduce) {
		.text-link,
		.text-link :global(.text-link__icon) {
			transition: none;
		}

		.text-link:hover :global(.text-link__icon) {
			transform: none;
		}
	}
</style>
