---
/**
 * Inline text link ("Više o nama", "Saznaj više", "Vidi više").
 * Plain underlined text, no arrow (user decision, styled after the gallery
 * reference). On hover the underline gets thicker; the accent variant also
 * darkens.
 *
 * Variants:
 * - `accent` (default): Accent text, for light sections.
 * - `inverse`: Primary text, for Accent/Dark sections.
 * - `light`: Light (#9DB3FF) text, for Dark sections (e.g. home Galerija);
 *   turns Primary on hover.
 */
interface Props {
	href: string;
	variant?: 'accent' | 'inverse' | 'light';
	class?: string;
}

const { href, variant = 'accent', class: className } = Astro.props;
---

<a href={href} class:list={['text-link', `text-link--${variant}`, className]}>
	<slot />
</a>

<style>
	.text-link {
		display: inline-block;
		font-size: var(--text-body);
		font-weight: var(--weight-medium);
		line-height: var(--leading-body);
		text-decoration-line: underline;
		text-decoration-thickness: var(--link-underline);
		text-underline-offset: var(--link-underline-offset);
		transition:
			color var(--duration-fast) ease,
			text-decoration-thickness var(--duration-fast) ease;
	}

	.text-link:hover {
		text-decoration-thickness: var(--link-underline-hover);
	}

	.text-link--accent {
		color: var(--color-accent);
	}

	.text-link--accent:hover {
		color: var(--color-accent-hover);
	}

	.text-link--inverse {
		color: var(--color-primary);
	}

	.text-link--light {
		color: var(--color-light);
	}

	.text-link--light:hover {
		color: var(--color-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.text-link {
			transition: none;
		}
	}
</style>
